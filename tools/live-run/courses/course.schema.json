                  "submissionSchemaId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "reviewQueue": {
          "type": "array",
          "items": {
            "type": "object",
