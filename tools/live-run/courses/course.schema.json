{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minisv.vip/schemas/course-package-v1.json",
  "title": "Mini Silicon Valley LIVE RUN Course Package v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "course",
    "case",
    "sources",
    "decks",
    "formula",
    "macroSteps",
    "blocks",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "course": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "period",
        "coverage",
        "description",
        "learnerName",
        "scriptId",
        "macroStepCount",
        "blockCount",
        "completeFiveStep"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "learnerName": {
          "type": "string",
          "minLength": 1
        },
        "scriptId": {
          "type": "string",
          "minLength": 1
        },
        "macroStepCount": {
          "const": 5
        },
        "blockCount": {
          "const": 13
        },
        "completeFiveStep": {
          "const": true
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "campaignId",
        "name",
        "learnerName",
        "period",
        "why"
      ],
      "properties": {
        "campaignId": {
          "enum": [
            "eleme-2008-find-problem",
            "google-1995-2004"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "learnerName": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "why": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "title",
          "organization",
          "url",
          "kind",
          "accessed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "organization": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "accessed": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decks": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "macroStepId",
          "drawAtBlockId",
          "cardsPerLearner",
          "uniqueDeal",
          "shuffle",
          "cards"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "macroStepId": {
            "enum": [
              "find",
              "decide",
              "build",
              "market",
              "operate"
            ]
          },
          "drawAtBlockId": {
            "enum": [
              "B01",
              "B04",
              "B06",
              "B09",
              "B11"
            ]
          },
          "cardsPerLearner": {
            "const": 3
          },
          "uniqueDeal": {
            "const": true
          },
          "shuffle": {
            "const": true
          },
          "cards": {
            "type": "array",
            "minItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "id",
                "boundary",
                "title",
                "body",
                "sharePrompt",
                "sourceIds"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "boundary": {
                  "enum": [
                    "F",
                    "G",
                    "R",
                    "U"
                  ]
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "body": {
                  "type": "string",
                  "minLength": 1
                },
                "sharePrompt": {
                  "type": "string",
                  "minLength": 1
                },
                "sourceIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "macroSteps": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "blocks": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "macroStepId",
          "macroStepOrder",
          "order",
          "title",
          "leadMentorId",
          "suggestedMinutes",
          "gameModes",
          "apiAction",
          "underlyingClassroomPhases",
          "historyTrack",
          "realityTrack",
          "studentPrompt",
          "mentorScript",
          "studentActions",
          "systemActions",
          "props",
          "evidenceGate",
          "fallback",
          "manualInteraction",
          "learnerLens",
          "seatTasks"
        ],
        "properties": {
          "id": {
            "pattern": "^B(?:0[1-9]|1[0-3])$"
          },
          "macroStepId": {
            "enum": [
              "find",
              "decide",
              "build",
              "market",
              "operate"
            ]
          },
          "macroStepOrder": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 13
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "leadMentorId": {
            "enum": [
              "mentor01",
              "mentor02",
              "mentor03",
              "mentor04"
            ]
          },
          "suggestedMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 180
          },
          "gameModes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "american",
                "euro",
                "yarn"
              ]
            }
          },
          "apiAction": {
            "enum": [
              "room-and-deal",
              "read-and-publish",
              "finish-find-chapter",
              "prepare-decide-value",
              "finish-decide-chapter",
              "prepare-build-mvp",
              "run-build-pressure",
              "finish-build-chapter",
              "prepare-market",
              "finish-market-chapter",
              "prepare-operations",
              "run-operations-and-freeze",
              "submit-demo-and-complete"
            ]
          },
          "underlyingClassroomPhases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "historyTrack": {
            "type": "string",
            "minLength": 1
          },
          "realityTrack": {
            "type": "string",
            "minLength": 1
          },
          "studentPrompt": {
            "type": "string",
            "minLength": 1
          },
          "mentorScript": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "studentActions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "systemActions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "props": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceGate": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fallback": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "manualInteraction": {
            "type": "string",
            "minLength": 1
          },
          "learnerLens": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "world",
              "say",
              "ask",
              "done"
            ],
            "properties": {
              "world": {
                "type": "string",
                "minLength": 1
              },
              "say": {
                "type": "string",
                "minLength": 1
              },
              "ask": {
                "type": "string",
                "minLength": 1
              },
              "done": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "seatTasks": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mentor01",
              "mentor02",
              "mentor03",
              "mentor04",
              "learner01",
              "learner02",
              "learner03",
              "learner04"
            ],
            "properties": {
              "mentor01": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "badge",
                  "task"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "active",
                      "standby",
                      "support"
                    ]
                  },
                  "badge": {
                    "type": "string",
                    "minLength": 1
                  },
                  "task": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "mentor02": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "badge",
                  "task"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "active",
                      "standby",
                      "support"
                    ]
                  },
                  "badge": {
                    "type": "string",
                    "minLength": 1
                  },
                  "task": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "mentor03": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "badge",
                  "task"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "active",
                      "standby",
                      "support"
                    ]
                  },
                  "badge": {
                    "type": "string",
                    "minLength": 1
                  },
                  "task": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "mentor04": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "badge",
                  "task"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "active",
                      "standby",
                      "support"
                    ]
                  },
                  "badge": {
                    "type": "string",
                    "minLength": 1
                  },
                  "task": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "learner01": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "badge",
                  "task"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "active",
                      "standby",
                      "support"
                    ]
                  },
                  "badge": {
                    "type": "string",
                    "minLength": 1
                  },
                  "task": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "learner02": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "badge",
                  "task"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "active",
                      "standby",
                      "support"
                    ]
                  },
                  "badge": {
                    "type": "string",
                    "minLength": 1
                  },
                  "task": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "learner03": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "badge",
                  "task"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "active",
                      "standby",
                      "support"
                    ]
                  },
                  "badge": {
                    "type": "string",
                    "minLength": 1
                  },
                  "task": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "learner04": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "state",
                  "badge",
                  "task"
                ],
                "properties": {
                  "state": {
                    "enum": [
                      "active",
                      "standby",
                      "support"
                    ]
                  },
                  "badge": {
                    "type": "string",
                    "minLength": 1
                  },
                  "task": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "formula": {
      "type": "object"
    },
    "rules": {
      "type": "object"
    },
    "authoring": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "enum": [
            "draft",
            "published"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "string"
        }
      }
    }
  }
}
