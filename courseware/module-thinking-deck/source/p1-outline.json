      {
        "id": "e6250dd0-f342-4fa5-84e8-d8b38855d199",
        "title": "课程定位与两课承接",
        "children": [
          {
            "id": "4d430dca-0ca5-4727-be1c-31dbb4432a0e",
            "title": "第一课只解决一件事：把一个大问题拆成能独立工作、又能重新拼起来的小模块"
          },
          {
            "id": "6de8bf3a-1ba9-4c42-8e3e-2ac7883a5bf8",
            "title": "一句话主棍：模块 = 有明确任务、输入、输出和接口的基本功能单元"
          },
          {
            "id": "c37af8dd-2759-4dac-ba50-0af09d026dad",
            "title": "学员产出：一张“项目模块地图” + 一张“模块接口卡”"
          },
          {
            "id": "88ab7934-2a70-48c5-a7f2-72eadc7ea92d",
            "title": "承接P2：模块拆出来以后，下一课用“立棍”说清每个模块做到什么才算完成"
          }
        ]
      },
      {
        "id": "d313837e-c8a8-4abc-8204-0bb6ebd3b456",
        "title": "互动问答与硅谷币机制（初中生版）",
        "children": [
          {
            "id": "56c611bc-a3a1-4ff4-8f0b-c0b366180e8c",
            "title": "设计目标：每2—4分钟让学生做一次可回答、可选择、可动手的互动；先体验，再由导师命名抽象概念"
          },
          {
            "id": "df6ab161-220e-4723-96b7-0423badd38b3",
            "title": "硅谷币发放规则",
            "children": [
              {
                "id": "e0e99197-b7db-46d1-992b-a658ab7a54b4",
                "title": "1币｜愿意参与：举手、选择、贴卡、说出一个具体例子"
              },
              {
                "id": "543224dd-c512-4bb6-8358-10fb91660572",
                "title": "2币｜讲清理由：使用“因为……所以……”完成解释"
              },
              {
                "id": "8270282c-b1de-424d-b1ea-5cbdc4b31754",
                "title": "＋1币｜拿出证据或帮助队友：引用案例细节、补充关键线索、把队友观点讲得更清楚"
              },
              {
                "id": "74b4492f-ff59-465a-a220-f056fb6197c1",
                "title": "团队奖3—6币｜完成排序、拼装、找错或接口测试等合作挑战"
              },
              {
                "id": "b9f1d374-be23-4194-91b4-32f71a614d17",
                "title": "不因答错扣币；同一轮个人通常最多3币，避免只奖励抢答快的学生"
              }
            ]
          },
          {
            "id": "31ac4d67-16b5-47a7-b476-442b46b369bd",
            "title": "导师发币口令",
            "children": [
              {
                "id": "98fe3e17-59ae-45ea-b1a2-9708db4992eb",
                "title": "“1枚参与币：你把想法说出来了。”"
              },
              {
                "id": "ba9f8307-1ffc-476e-9345-f384b33f1a7d",
                "title": "“再加1枚理由币：你讲清了为什么。”"
              },
              {
                "id": "e0296174-d5e0-415d-a79a-c975650b96cb",
                "title": "“再加1枚证据/助攻币：你用线索支持了判断，或让队友更容易理解。”"
              }
            ]
          },
          {
            "id": "93760d9e-12b0-43ec-94f7-ca011691c145",
            "title": "公平节奏",
            "children": [
              {
                "id": "9520b433-46ac-47e8-889a-fcc1bf84cf4c",
                "title": "先独立想10秒 → 两人互说 → 再全班回答，给安静学生准备时间"
              },
              {
                "id": "b74d06b7-bc65-433e-bd6a-28c0c2129dc5",
                "title": "抢答、点名、全员举牌、团队动手轮换使用；不把课堂变成少数人的竞速赛"
              },
              {
                "id": "0ec9ffa3-0e4a-4655-ad8b-616b0684b684",
                "title": "每4页安排一次团队任务；币奖励学习行为，不奖励“猜中老师心里的唯一答案”"
              }
            ]
          },
          {
            "id": "03597858-33d5-4040-a710-913921aad021",
            "title": "本模块建议币量：个人约8—15币；团队约12—24币。导师可按课堂时长等比例缩放"
          }
        ]
      },
      {
        "id": "fbc02563-de86-47af-8525-84020acda6e7",
        "title": "PPT提纲（建议16页）",
        "children": [
          {
            "id": "2960804f-9c5d-41d9-b6a6-3b45461bbabc",
            "title": "S01｜任务开场：一口吞不下的大象，怎么做？",
            "children": [
              {
                "id": "d2a2e21c-25cf-4b94-b31d-a069201aacc1",
                "title": "情境：四个人要在一小时内做出“校园失物招领工具”"
              },
              {
                "id": "6e0e5d35-2ce4-47b1-8a55-163d0c152675",
                "title": "先让学员说：如果所有人同时改同一份东西，会发生什么？"
              },
              {
                "id": "f546fb5a-e5ea-4d6d-9ebf-4f681ea63a91",
                "title": "本页结论：先拆块，再分工，最后按接口拼回来"
              },
              {
                "id": "589c4eb2-c0fc-4c0d-bb2e-0d94e9fa3e6a",
                "title": "互动Q｜如果四个人同时改同一张海报，最可能先发生什么？",
                "children": [
                  {
                    "id": "a2b30c32-e9d7-4659-9c37-7898820ef0b2",
                    "title": "A 内容重复｜B 互相覆盖｜C 谁都以为别人会做｜D 以上都可能"
                  },
                  {
                    "id": "31a17b63-7836-456a-80a9-8d33dafdad65",
                    "title": "先全员手势投票，再请2人说“我为什么这样选”"
                  },
                  {
                    "id": "290dd2ef-87f5-41a3-a332-752dc538100b",
                    "title": "发币：投票1币；用具体经历解释2币；补充一种新风险＋1币"
                  }
                ]
              },
              {
                "id": "63c13fcc-1d50-4b9d-af9e-4adb9563fefc",
                "title": "互动任务｜30秒乱做实验",
                "children": [
                  {
                    "id": "5cffd1b2-bfbf-440f-a1ea-ec8de3bc10b6",
                    "title": "四人同时口头安排“校园失物招领工具”，不准先分工"
                  },
                  {
                    "id": "2e985536-c36f-444a-b0ed-3a3e572c8656",
                    "title": "导师追问：刚才哪里乱？如果重来，第一刀怎么拆？"
                  },
                  {
                    "id": "75f9f840-06bf-4c2b-8365-ce5d7fc4883a",
                    "title": "团队奖：说出“先拆块—再分工—按接口拼回”中的2项得3币"
                  }
                ]
              }
            ]
          },
          {
            "id": "06ac03bb-4a89-4567-a7c5-c798e23ee5fa",
            "title": "S02｜生活里早就有模块",
            "children": [
              {
                "id": "63beafef-83ca-49e4-a0a2-09829f27c1d2",
                "title": "案例A：积木——每块形状不同，但接口统一，所以能组合"
              },
              {
                "id": "69764f1c-df87-4f5d-851f-e13e3ffb6285",
                "title": "案例B：餐厅——点单、做饭、打包、配送各自完成一个功能"
              },
              {
                "id": "679a4d61-4e18-4213-9ff7-c287528bc0f6",
                "title": "案例C：3D打印——多个组件单独制造，最终装成一个整体【来自9月12日原材料】"
              },
              {
                "id": "b2eede86-d4e7-43cc-8ad0-3664dda3a3cc",
                "title": "互动：每人再举一个“由模块组成的东西”"
              },
              {
                "id": "4ec07155-4ec9-4858-84f5-f53ce925b7d7",
                "title": "互动Q｜模块猎人：你的书包、游戏或食堂里，哪些东西是“可以单独工作、又能组合”的？",
                "children": [
                  {
                    "id": "51fea142-bfb1-4c2d-b8d7-c2eb5cb475e9",
                    "title": "先自己找1个，再和同桌互相判断“它为什么算模块”"
                  },
                  {
                    "id": "5b853f48-1de7-425b-b54a-a382bf6358a6",
                    "title": "发币：具体例子1币；讲出独立任务或统一接口2币"
                  }
                ]
              },
              {
                "id": "dfd0665c-c013-450b-8271-2b00b843c99b",
                "title": "互动Q｜餐厅少了哪一块会发生什么？",
                "children": [
                  {
                    "id": "7b5d3742-1366-4642-8c47-c9a394ceb966",
                    "title": "少了点单／做饭／打包／配送中的一块，让学生任选并描述后果"
                  },
                  {
                    "id": "01dbd10a-67a3-40fa-a3b6-807d35304ced",
                    "title": "追问：其他模块还能不能继续工作？这能帮助我们看见模块边界"
                  }
                ]
              }
            ]
          },
          {
            "id": "947d51c8-ca6d-4ae2-b4e9-36913ce2e0ec",
            "title": "S03｜什么叫模块？",
            "children": [
              {
                "id": "8aaa872b-c457-43a0-9c3a-2e3e443b2f02",
                "title": "模块不是随便切一刀，而是能独立完成一个清楚任务的功能单元"
              },
              {
                "id": "25be1a0c-ae51-4d16-b85d-c0ac29e2ee21",
                "title": "四个要素：输入 → 处理 → 输出 → 接口"
              },
              {
                "id": "ce5eea99-9ee5-4e60-84f9-90886d0811bf",
                "title": "例子：登录模块输入账号密码，输出“允许进入/拒绝进入”，接口是登录按钮与认证API"
              },
              {
                "id": "ab3a7fcb-eee3-4d27-be91-fcd82d7da509",
                "title": "互动任务｜四要素配对",
                "children": [
                  {
                    "id": "40932b06-b75c-4c84-929a-8e873b5dca52",
                    "title": "卡片：账号密码／核对身份／允许或拒绝进入／登录按钮与认证API"
                  },
                  {
                    "id": "cad81bbe-c1e6-4aba-81f8-3dda6fa12698",
                    "title": "学生把四张卡贴到“输入—处理—输出—接口”"
                  },
                  {
                    "id": "a323ec5b-318b-40bd-a006-7c6d2de6f0cd",
                    "title": "团队奖：全对3币；能解释一处配对再＋1币"
                  }
                ]
              },
              {
                "id": "ba5e95a8-76e2-4469-a89f-8f1e37726804",
                "title": "互动Q｜自动门是不是模块？",
                "children": [
                  {
                    "id": "1322359f-ee34-4b0e-a350-b82868ab36c1",
                    "title": "学生必须用四要素回答，不只说“是/不是”"
                  },
                  {
                    "id": "100e6445-2c43-4f93-9f9e-0dec5a654fda",
                    "title": "发币：指出输入和输出2币；补充异常情况＋1币"
                  }
                ]
              }
            ]
          },
          {
            "id": "ee488cdb-0a95-4e57-b21f-68fc25629bdc",
            "title": "S04｜为什么要模块化？",
            "children": [
              {
                "id": "6732cff9-92e6-4d34-8d56-533150123705",
                "title": "看得懂：复杂系统被拆成几块清楚的责任"
              },
              {
                "id": "b5e69581-9116-4602-bfa5-2d7dfdab4b99",
                "title": "能分工：不同成员可以并行推进"
              },
              {
                "id": "84243586-4515-4478-8d65-8ac444442f6a",
                "title": "能替换：坏一块，尽量不重做全部"
              },
              {
                "id": "0e73d019-89b1-46ef-b758-2be4e018ec50",
                "title": "能复用：一个登录模块可以服务多个页面"
              },
              {
                "id": "1cd4ba63-1126-4f87-a70a-d87bea53c7dd",
                "title": "互动Q｜坏掉一块，你选“整辆车重造”还是“只换轮胎”？为什么？",
                "children": [
                  {
                    "id": "8b5736e6-37f9-4c0f-9cbf-8c209fac1b93",
                    "title": "把答案连接到看得懂、能分工、能替换、能复用"
                  },
                  {
                    "id": "28d12f26-fa3d-4bd9-9508-2b8ea51cb6e5",
                    "title": "发币：选择并说明1—2币；能命名对应好处＋1币"
                  }
                ]
              },
              {
                "id": "726ec6d2-ad9c-406c-8322-e5b9819627c9",
                "title": "全员快答｜导师读4个场景，学生举牌判断：分工／替换／复用／看懂"
              }
            ]
          },
          {
            "id": "5c574daa-ae9e-486d-b801-7b1d331ef9b6",
            "title": "S05｜功能、模块、产品不要混在一起",
            "children": [
              {
                "id": "cfd33c9a-fa7f-4401-a453-069c37dc57a8",
                "title": "功能：用户能完成的一件事，例如“提交失物信息”"
              },
              {
                "id": "a7b76313-e98d-496c-b9b7-ea9a35dbf842",
                "title": "模块：支撑一个或一组功能的可管理单元，例如“信息发布模块”"
              },
              {
                "id": "885c4ffc-d6cd-4ce3-acb4-19cba718fd81",
                "title": "产品：多个模块沿用户路径组合后，真正解决用户问题的整体"
              },
              {
                "id": "ce273bed-9d0b-4adc-8941-3a046c638ccd",
                "title": "检查题：“按钮”一定是模块吗？不一定，要看它是否承担独立责任"
              },
              {
                "id": "f6110091-9794-48eb-adc2-db12c8c09217",
                "title": "互动Q｜三秒判断：这是功能、模块，还是产品？",
                "children": [
                  {
                    "id": "149a8e77-ec22-4986-b6c1-09d8be312ef3",
                    "title": "题目：发布失物／信息发布模块／校园失物招领工具／一个红色按钮"
                  },
                  {
                    "id": "919de7a1-4896-4fad-b167-9de253c1aa48",
                    "title": "红色按钮设为陷阱题：外观元素不一定承担独立责任"
                  },
                  {
                    "id": "e349b71e-f094-4fbb-a4eb-c83be0abd79b",
                    "title": "发币：判断1币；用“是否承担独立责任”解释2币"
                  }
                ]
              }
            ]
          },
          {
            "id": "36397cd4-4b6d-40dd-ab53-e4104c742844",
            "title": "S06｜用户路径是串起模块的主线",
            "children": [
              {
                "id": "b32c7d4c-808a-4823-b7e5-436317fce145",
                "title": "【原材料】先给用户一条清楚的操作路径"
              },
              {
                "id": "aef3c5ec-eeb2-4a93-b0b0-4dd5fd3855f6",
                "title": "示例：发现物品 → 拍照登记 → 系统发布 → 失主搜索 → 身份核对 → 取回"
              },
              {
                "id": "e2ff2a97-9858-4184-94f1-771fbe8f8a6b",
                "title": "每一步都问：谁在什么场景下，要完成什么？"
              },
              {
                "id": "09a82698-a5fb-4479-b82f-790773eb7f30",
                "title": "不要先按技术名词拆；先按真实用户行动拆"
              },
              {
                "id": "40000ec4-f4b7-4a6b-822b-e11f1097f6c0",
                "title": "互动任务｜真人演一遍失物招领",
                "children": [
                  {
                    "id": "cf6b79a0-e155-4251-922b-a5225e31b98e",
                    "title": "6名学生分别扮演发现者、登记、发布、搜索、核对、取回"
                  },
                  {
                    "id": "9ee169b8-067c-440f-84d3-d978232e5abf",
                    "title": "每人只说“我拿到什么、我交出什么”"
                  },
                  {
                    "id": "5580f4ed-f815-4542-b815-73d43d8efe44",
                    "title": "团队奖：路径连通3币；发现缺失一步或断点再＋2币"
                  }
                ]
              },
              {
                "id": "0da37f4b-9de4-4e74-b8ac-6ea322d8f5ea",
                "title": "互动Q｜如果先画页面、不问用户在做什么，可能漏掉谁或漏掉哪一步？"
              }
            ]
          },
          {
            "id": "661825e6-9382-4bc3-9358-5410d1cb342e",
            "title": "S07｜从需求归纳功能，再从功能归纳模块",
            "children": [
              {
                "id": "2e576299-413b-4f7b-a03c-82eeea6e01ea",
                "title": "多人原话通常很乱：先找共同任务与重复动作"
              },
              {
                "id": "d965e754-ec61-429f-8f1f-5b5a822ae93f",
                "title": "把多个功能共同需要的能力归为同一模块【来自9月12日原材料】"
              },
              {
                "id": "8945992d-f2fe-4a73-82b1-f40268ea0487",
                "title": "时间顺序决定流程，空间/数据关系决定模块如何连接"
              },
              {
                "id": "00ceb822-e82d-474d-8443-bfb2b57c5a27",
