<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.minisv.live-run-controller</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string>
    <string>__HOME__/Services/minisv/current/live-run/controller.py</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>18790</string>
    <string>--state-dir</string><string>__HOME__/Services/minisv/data/controller</string>
    <string>--course-dir</string><string>__HOME__/Services/minisv/data/courses</string>
    <string>--api-base</string><string>http://127.0.0.1:18787</string>
    <string>--accounts</string><string>__HOME__/Services/minisv/secrets/accounts.json</string>
    <string>--auth-session-url</string><string>http://127.0.0.1:18787/api/auth/session</string>
    <string>--service-key-file</string><string>__HOME__/Services/minisv/secrets/controller-service.key</string>
    <string>--public-origin</string><string>https://minisv.vip</string>
    <string>--public-base</string><string>/control/</string>
    <string>--login-path</string><string>/auth/login</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/Services/minisv/current/live-run</string>
  <key>EnvironmentVariables</key><dict><key>PYTHONUNBUFFERED</key><string>1</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__HOME__/Services/minisv/logs/controller.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Services/minisv/logs/controller.err.log</string>
</dict></plist>
