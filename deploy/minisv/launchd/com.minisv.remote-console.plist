<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.minisv.remote-console</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/node</string>
    <string>__HOME__/Services/minisv/current/live-run/remote-console/server.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/Services/minisv/current/live-run</string>
  <key>EnvironmentVariables</key><dict>
    <key>MSV_CONTROLLER_BASE</key><string>http://127.0.0.1:18790</string>
    <key>MSV_CONTROLLER_SERVICE_KEY_FILE</key><string>__HOME__/Services/minisv/secrets/controller-service.key</string>
    <key>MSV_CONSOLE_HOST</key><string>127.0.0.1</string>
    <key>MSV_CONSOLE_PORT</key><string>18791</string>
    <key>MSV_CONSOLE_STATE</key><string>__HOME__/Services/minisv/data/console/claims.json</string>
    <key>MSV_CONSOLE_STATIC</key><string>__HOME__/Services/minisv/current/live-run/remote-console/static</string>
    <key>MSV_SEAT_STATIC</key><string>__HOME__/Services/minisv/current/live-run/static</string>
  </dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>__HOME__/Services/minisv/logs/console.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Services/minisv/logs/console.err.log</string>
</dict></plist>
